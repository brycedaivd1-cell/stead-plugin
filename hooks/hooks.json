{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.cjs\"", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Read|Grep|Glob|Agent|Task",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/delegation-guard.cjs\"", "timeout": 10 } ] }
    ]
  }
}
